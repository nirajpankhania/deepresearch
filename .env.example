# Copy to .env for local development. Never commit the filled-in version.
#
# Secret inventory is two entries, and only one of them is a third-party
# credential:
#   VALYU_API_KEY    the only third-party credential in the system. Vertex AI
#                    authenticates via the worker's service account, so there
#                    is no model-provider key anywhere.
#   BACKEND_API_KEY  self-issued token protecting the public API endpoint. An
#                    open endpoint backed by paid search and model calls is a
#                    cost-exposure problem, not a data-privacy one.
#
# In production neither is set by hand: both are injected into Cloud Run from
# Secret Manager, and BACKEND_API_KEY is additionally set as a server-side
# environment variable in Vercel.

# --- Shared -----------------------------------------------------------------
GCP_PROJECT_ID=deepresearch-504612
GCP_REGION=europe-west2

# --- API service ------------------------------------------------------------
API_PORT=8080
# Sent by the Next.js route handler as the X-API-Key header. Generate with:
#   openssl rand -hex 32
BACKEND_API_KEY=
# Comma-separated origins permitted by CORS. The deployed value is the Vercel
# domain; localhost is for local frontend development only.
ALLOWED_ORIGINS=http://localhost:3000

# Which TaskDispatcher implementation to use.
#   cloudtasks  production: named tasks give idempotent enqueue
#   local       development: POST straight to the worker, bypassing the queue
DISPATCHER=local
TASKS_QUEUE=research-tasks
# Cloud Run URL of the worker, and the service account Cloud Tasks mints an
# OIDC token for. Required when DISPATCHER=cloudtasks.
WORKER_URL=
TASKS_INVOKER_SA=
# Required when DISPATCHER=local.
WORKER_LOCAL_URL=http://localhost:8081

# How long after its lease lapses a running task is treated as abandoned and
# marked failed on read. Must exceed the queue's maxRetryDuration plus its
# longest backoff (900s x 3 + 300s = 3000s): reaping too eagerly would write a
# terminal state that makes a legitimate in-flight retry no-op.
ORPHAN_GRACE_SECONDS=3600

# --- Worker service ---------------------------------------------------------
WORKER_PORT=8081
VALYU_API_KEY=
GCS_TRACE_BUCKET=

# Lets a question containing __FORCE_FAILURE__ fail deliberately, so the failure
# path is reachable without waiting for a real outage. Off unless set to "true".
FAULT_INJECTION_ENABLED=false

# Model IDs, resolved against Vertex AI's global endpoint. Verified 2026-08-05
# with live generateContent calls.
#
# There is no Gemini 3 Pro on this project (every gemini-3-*-pro form 404s), so
# synthesis uses 2.5 Pro. That model retires 16 October 2026; these are env vars
# precisely so the swap is a redeploy rather than a code change.
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_PRO_MODEL=gemini-2.5-pro

# --- Per-task limits --------------------------------------------------------
# Hard cap on measured Valyu spend, checked before dispatching each search.
# Note that source pricing varies about eightfold, so this cap genuinely binds:
# ten results across five patent sub-queries would cost roughly $0.40.
MAX_TASK_COST_USD=0.30
# Bound on total model calls per task, independent of the pipeline's own limits.
# The pipeline makes four (plan, rerank, synthesise, ground); this is the guard
# against an orchestration bug looping.
MAX_MODEL_CALLS=12
# Lease held by a claiming worker. A lapsed lease means the attempt died and
# the task becomes claimable again. Matches the worker's Cloud Run timeout, so a
# lease cannot expire while its holder is still running.
LEASE_SECONDS=900

# --- Retrieval tuning -------------------------------------------------------
# Results requested per sub-query. Valyu permits 1-20. Directly proportional to
# retrieval spend, and deduplication already discards a third to a half.
MAX_RESULTS_PER_QUERY=10
# Valyu's own relevance floor, applied per sub-query before results reach us.
RELEVANCE_THRESHOLD=0.5
# Cap on the corpus handed to synthesis, after deduplication and reranking.
MAX_SOURCES=20

# Note: Cloud Run injects PORT at runtime and it takes precedence over
# API_PORT / WORKER_PORT. Do not set it here.
